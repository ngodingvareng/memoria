                "name",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "budi@example.com"
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "Budi Santoso"
                },
                "password": {
                    "description": "scrypt hashes the whole password with no truncation. max=256 is\njust a generous sane upper bound (prevents someone posting a\nmulti-KB \"password\" that'd waste CPU/memory on the scrypt KDF\nfor no real security benefit).",
                    "type": "string",
                    "maxLength": 256,
                    "minLength": 8,
