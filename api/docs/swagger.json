                    "description": "AccessToken is meant to be held in memory on the frontend (not\nlocalStorage) and sent via the Authorization: Bearer header.",
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                },
                "expires_in": {
                    "description": "ExpiresIn is in seconds, so the frontend can schedule a silent\nrefresh shortly before the access token actually expires.",
                    "type": "integer",
                    "example": 900
                },
                "user": {
