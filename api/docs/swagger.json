        "/auth/refresh": {
            "post": {
                "description": "Reads the refresh token from the httpOnly cookie, rotates\nit, and returns a new access token plus a new refresh\ncookie. Reusing an already-rotated refresh token revokes\nits entire token family and forces a fresh login.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Exchange the refresh token cookie for a new access/refresh token pair",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_ngodingvareng_memoria_internal_delivery_rest_dto.WebResponse-github_com_ngodingvareng_memoria_internal_delivery_rest_dto_LoginResponse"
