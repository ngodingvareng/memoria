                        }
                    }
                }
            },
            "post": {
                "description": "Create a new activity for the authenticated user",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "activities"
                ],
                "summary": "Create a new activity",
                "parameters": [
                    {
                        "description": "Create activity request",
                        "name": "request",
                        "in": "body",
                        "required": true,
