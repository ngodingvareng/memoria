SERVER_PORT=3000
SECURE_COOKIES=false

JWT_SECRET=memoria
JWT_ISSUER=memoria
JWT_ACCESS_TOKEN_TTL=5m
JWT_REFRESH_TOKEN_TTL=168h # 7 days

# DATABASE_HOST defaults to localhost (make dev / tests); set it to the
# Postgres service name (e.g. "postgres") when running via docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_DBNAME=memoria
DATABASE_PORT=5432

STORAGE_ENDPOINT=/
STORAGE_REGION=ap-southeast-3
STORAGE_ACCESS_KEY=memoria
STORAGE_SECRET_KEY=memoria
STORAGE_BUCKET=memoria
STORAGE_USE_PATH_STYLE=true

# Comma-separated list of origins allowed to call this API cross-origin
# (e.g. the web/ dev server). Leave empty to block all cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per-IP rate limit on POST /auth/login and /auth/register.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1m

# Per-account lockout: after this many consecutive failed login
# attempts, the credential account is locked for LOGIN_LOCKOUT_DURATION.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m